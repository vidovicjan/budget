{
  "name": "budget-tracker",
  "productName": "Budget Tracker",
  "version": "1.4.0",
  "private": true,
  "description": "A personal budget tracker desktop app. All data stays on this device.",
  "author": "Budget Tracker",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c blue,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always",
    "ship": "npm version patch -m \"Release %s\" && git push --follow-tags"
  },
  "build": {
    "appId": "com.budgettracker.desktop",
    "productName": "Budget Tracker",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Budget-Tracker-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vidovicjan",
        "repo": "budget",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
